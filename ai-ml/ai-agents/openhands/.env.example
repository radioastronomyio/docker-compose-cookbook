# OpenHands Docker Environment Variables

# Web UI Port
OPENHANDS_PORT=3000

# Ollama Connection
OLLAMA_PORT=11434

# Workspace Configuration
# Absolute path to the directory where OpenHands will write code
# This persists even if the container is recreated
WORKSPACE_BASE=/home/username/openhands-workspace

# Match your host user ID to prevent permission issues on generated files
# Find with: id -u
SANDBOX_USER_ID=1000

# Logging
LOG_ALL_EVENTS=true

# SECURITY WARNING
# ================
# This container has Docker socket access, granting it root-equivalent
# privileges on the host Docker daemon.
#
# NEVER expose this service directly to the internet.
# Run behind VPN or strict firewall rules only.
