# CVAT Docker Environment Variables

# Web UI Port
CVAT_PORT=8090

# PostgreSQL Configuration
# CRITICAL: Change this password immediately
CVAT_POSTGRES_PASSWORD=CvatStrongPass!

# Host Configuration
# CRITICAL: Set to your machine's IP or FQDN
# Do NOT use localhost if accessing from other machines
# The UI will break due to Traefik routing rules
CVAT_HOST=192.168.1.50

# Post-Deployment Setup
# =====================
# After the stack stabilizes, create the superuser manually:
# docker exec -it cvat_server bash -ic 'python3 ~/manage.py createsuperuser'
