# Label Studio Docker Environment Variables

# Web UI Port
LABEL_STUDIO_PORT=8080

# PostgreSQL Configuration
# CRITICAL: Change this password immediately
PG_PASSWORD=SecureLabelPass2025!

# External URL
# Required for ML backend callbacks - set to your accessible address
LABEL_STUDIO_HOST=http://localhost:8080

# SSRF Protection
# Set to false if accessing internal S3/MinIO buckets
SSRF_PROTECTION=true

# ML Backend Connection (optional)
# If using pre-labeling models, configure the ML backend URL
# ML_BACKEND_URL=http://host.docker.internal:9090
