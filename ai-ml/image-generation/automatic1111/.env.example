# Automatic1111 Configuration

# Command line arguments
# --listen: Bind to all interfaces
# --xformers: Memory-efficient attention
# --medvram: For 8-12GB cards (reduces speed slightly)
# --api: Enable REST API
CLI_ARGS=--listen --enable-insecure-extension-access --xformers --api

# PyTorch memory allocation tuning
# Helps prevent fragmentation during long sessions
PYTORCH_CUDA_ALLOC_CONF=garbage_collection_threshold:0.6,max_split_size_mb:128
