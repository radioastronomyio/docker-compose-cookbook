# Ollama Docker Environment Variables

# Network Configuration
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434

# VRAM Management
# Keep models loaded in VRAM (default: 5m, use -1 for infinite)
OLLAMA_KEEP_ALIVE=24h

# Parallel request handling (reduce for larger models)
OLLAMA_NUM_PARALLEL=2

# Performance Options
# Enable flash attention if supported by model build
OLLAMA_FLASH_ATTENTION=0

# Debugging
OLLAMA_DEBUG=false
