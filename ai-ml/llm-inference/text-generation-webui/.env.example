# Text Generation WebUI Docker Environment Variables

# Network Configuration
WEBUI_PORT=7860
API_PORT=5000

# CLI Arguments
# --listen: bind to all interfaces
# --api: enable API endpoint
# --xformers: memory-efficient attention
# --n-gpu-layers: GPU layer offloading (adjust based on VRAM)
CLI_ARGS=--listen --api --xformers --n-gpu-layers 128

# GPU Selection
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# Extensions (comma-separated)
# EXTENSIONS=openai
