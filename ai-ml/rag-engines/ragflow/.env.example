# RAGFlow Docker Environment Variables

# Timezone
TZ=America/New_York

# RAGFlow Ports
RAGFLOW_PORT=9380
RAGFLOW_HTTP_PORT=80
RAGFLOW_HTTPS_PORT=443

# MySQL Configuration
# CRITICAL: Change this password immediately
MYSQL_PASSWORD=StrongMysqlPass123!

# MinIO Object Storage
MINIO_USER=ragflow
# CRITICAL: Change this password immediately
MINIO_PASSWORD=StrongMinioPass123!

# Redis Cache
# CRITICAL: Change this password immediately
REDIS_PASSWORD=StrongRedisPass123!

# Elasticsearch Heap Size
# Adjust based on available RAM (512m minimum, 2g recommended for large datasets)
ES_HEAP=512m

# WSL2 Host Configuration (REQUIRED)
# Run this command on Windows host BEFORE starting:
# wsl -d <distro-name> -u root sysctl -w vm.max_map_count=262144
#
# Or add to %USERPROFILE%\.wslconfig:
# [wsl2]
# kernelCommandLine = "sysctl.vm.max_map_count=262144"
