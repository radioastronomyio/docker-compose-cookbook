# Perplexica Docker Environment Variables

# SearXNG Metasearch Port
SEARXNG_PORT=4000

# Perplexica Ports
PERPLEXICA_PORT=3000
PERPLEXICA_API_PORT=3001

# Ollama Connection
# Ensure Ollama is running on host with OLLAMA_ORIGINS="*" or appropriate CORS
OLLAMA_PORT=11434

# Model Configuration (set in config.toml)
# Default model for chat: llama3.2
# Default model for embeddings: nomic-embed-text
