# Postiz Docker Environment Variables

# Web UI Port
POSTIZ_PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:5000

# JWT Secret
# CRITICAL: Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# PostgreSQL Password
# CRITICAL: Change this password immediately
PG_PASSWORD=StrongPostizPass2025!

# Social Platform Integration
# ===========================
# Configure OAuth credentials for each platform in the UI after setup.
# Supported platforms: X (Twitter), LinkedIn, Facebook, Instagram, etc.

# First Run
# =========
# 1. Access http://localhost:5000
# 2. Create your account
# 3. Connect social media accounts via OAuth
# 4. Schedule your first post
