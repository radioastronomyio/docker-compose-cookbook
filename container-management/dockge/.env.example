# Dockge Docker Environment Variables

# Web UI Port
DOCKGE_PORT=5001

# Stacks Directory
# All compose stacks managed by Dockge live here (one folder per stack)
# This directory is mounted to allow version control and backup
STACKS_DIR=/opt/stacks

# Directory Structure
# ===================
# /opt/stacks/
# ├── my-app/
# │   ├── docker-compose.yml
# │   └── .env
# ├── another-app/
# │   ├── docker-compose.yml
# │   └── .env
# └── ...
