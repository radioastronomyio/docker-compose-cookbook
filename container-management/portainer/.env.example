# Portainer Docker Environment Variables

# HTTPS Port (recommended)
PORTAINER_PORT=9443

# HTTP Port (optional, for legacy access)
PORTAINER_HTTP_PORT=9000

# Security Notes
# ==============
# - First user to access becomes admin
# - HTTPS is enabled by default on port 9443
# - Docker socket access grants root-equivalent privileges
# - Consider using a Docker socket proxy for additional isolation
