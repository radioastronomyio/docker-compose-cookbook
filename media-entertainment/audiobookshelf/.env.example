# Audiobookshelf Docker Environment Variables

# Web UI Port
AUDIOBOOKSHELF_PORT=13378

# Media Paths
# Point these to your audiobook and podcast directories
AUDIOBOOKS_PATH=/path/to/audiobooks
PODCASTS_PATH=/path/to/podcasts

# Timezone
TZ=America/New_York

# Directory Structure
# ===================
# Audiobooks should be organized:
# /audiobooks/
# ├── Author Name/
# │   └── Book Title/
# │       ├── cover.jpg
# │       └── audiofile.m4b (or .mp3 files)
#
# Podcasts are managed automatically via RSS feeds.

# First Run
# =========
# 1. Access http://localhost:13378
# 2. Create admin account
# 3. Add libraries (point to /audiobooks and /podcasts)
# 4. Scan for content
