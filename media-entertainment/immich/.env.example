# Immich Environment Configuration
# Copy to .env and adjust as needed

# Photo library location (use absolute path in production)
UPLOAD_LOCATION=./library

# Database password
DB_PASSWORD=postgres

# Immich version (release, v1.99.0, etc.)
IMMICH_VERSION=release

# Optional: Reverse proxy URL
# IMMICH_SERVER_URL=https://photos.example.com
