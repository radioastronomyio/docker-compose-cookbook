# Beszel Docker Environment Variables

# Web UI Port
BESZEL_PORT=8090

# Agent Deployment
# ================
# Beszel uses a hub-agent architecture. Deploy the agent on each monitored host:
#
# docker run -d \
#   --name beszel-agent \
#   --restart unless-stopped \
#   --network host \
#   -v /var/run/docker.sock:/var/run/docker.sock:ro \
#   -e KEY="<your-key-from-hub>" \
#   -e HUB="<hub-ip>:45876" \
#   henrygd/beszel-agent
