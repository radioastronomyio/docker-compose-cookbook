# GlitchTip Docker Environment Variables

# Web UI Port
GLITCHTIP_PORT=8000

# PostgreSQL Password
# CRITICAL: Change this password immediately
PG_PASSWORD=StrongGlitchPass2025!

# Secret Key
# CRITICAL: Generate with: openssl rand -base64 32
GLITCHTIP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Domain Configuration
GLITCHTIP_DOMAIN=http://localhost:8000

# Email Configuration (optional)
# Console output (development):
EMAIL_URL=consolemail://
# SMTP example:
# EMAIL_URL=smtp://user:password@smtp.example.com:587
DEFAULT_FROM_EMAIL=noreply@localhost

# First Run
# =========
# Create superuser after stack is running:
# docker exec -it glitchtip-web ./manage.py createsuperuser
