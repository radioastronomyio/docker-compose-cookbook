# Nginx Proxy Manager Docker Environment Variables

# Ports
NPM_HTTP_PORT=80
NPM_ADMIN_PORT=81
NPM_HTTPS_PORT=443

# MariaDB Credentials
# CRITICAL: Change these passwords immediately
NPM_ROOT_PASS=StrongRootPass2025!
NPM_DB_PASS=StrongNpmPass2025!

# Default Admin Login (change after first login)
# =======================
# Email:    admin@example.com
# Password: changeme

# Shared Network
# ==============
# Other services can join the proxy_net network to be proxied
# without exposing their ports to the host:
#
# networks:
#   proxy_net:
#     external: true
