# Hoarder Docker Environment Variables

# Web UI Port
HOARDER_PORT=3000

# Application URL
NEXTAUTH_URL=http://localhost:3000

# Secret Keys
# CRITICAL: Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
MEILI_MASTER_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# AI Tagging (Optional)
# Connect to local Ollama for automatic content categorization
OLLAMA_BASE_URL=http://host.docker.internal:11434
INFERENCE_MODEL=llama3.2

# To disable AI features, leave these empty:
# OLLAMA_BASE_URL=
# INFERENCE_MODEL=

# First Run
# =========
# 1. Access http://localhost:3000
# 2. Create your account
# 3. Install browser extension for easy bookmarking
# 4. Start saving links, notes, and images
