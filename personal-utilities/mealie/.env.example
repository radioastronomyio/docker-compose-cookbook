# Mealie Docker Environment Variables

# Web UI Port
MEALIE_PORT=9925

# User Registration
# Set to false after creating your account(s)
ALLOW_SIGNUP=true

# User/Group IDs
PUID=1000
PGID=1000

# Timezone
TZ=America/New_York

# Performance (adjust for your hardware)
MAX_WORKERS=1
WEB_CONCURRENCY=1

# PostgreSQL Backend (optional)
# Uncomment and configure for larger installations
# PG_PASSWORD=StrongMealiePass2025!

# Recipe Import
# =============
# Mealie can import recipes from URLs automatically.
# It extracts structured data (Schema.org/Recipe) from:
# - AllRecipes, Food Network, Serious Eats
# - Most major recipe sites
# - Any site with proper recipe markup

# First Run
# =========
# 1. Access http://localhost:9925
# 2. Create admin account
# 3. Start importing recipes via URL
