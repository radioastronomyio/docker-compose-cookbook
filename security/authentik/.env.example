# Authentik Docker Environment Variables

# Authentik Version
AUTHENTIK_TAG=2024.10.0

# Ports
AUTHENTIK_PORT=9000
AUTHENTIK_PORT_HTTPS=9443

# PostgreSQL Configuration
PG_USER=authentik
PG_DB=authentik
# CRITICAL: Change this password immediately
PG_PASS=StrongPostgresPass2025!

# Authentik Secret Key
# CRITICAL: Generate with: openssl rand -base64 32
# This key encrypts sensitive data - losing it means losing access
AUTHENTIK_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Optional: Email Configuration
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=authentik@example.com
# AUTHENTIK_EMAIL__PASSWORD=smtp_password
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=authentik@example.com

# Initial Setup
# =============
# After first start, navigate to:
# http://localhost:9000/if/flow/initial-setup/
# to create the initial admin account
