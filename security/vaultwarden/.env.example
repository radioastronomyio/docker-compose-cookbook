# Vaultwarden Docker Environment Variables

# Web UI Port
VAULTWARDEN_PORT=8085

# User Registration
# Set to false after creating your account(s)
SIGNUPS_ALLOWED=true

# Domain (for email links and WebAuthn)
DOMAIN=http://localhost:8085

# Admin Panel Token (optional)
# Generate with: openssl rand -base64 48
# Leave empty to disable admin panel
ADMIN_TOKEN=

# Email Configuration (optional, for password reset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=vaultwarden@example.com
# SMTP_PASSWORD=smtp_password
# SMTP_FROM=vaultwarden@example.com

# Security Reminder
# =================
# 1. Set SIGNUPS_ALLOWED=false after creating accounts
# 2. Place behind HTTPS reverse proxy in production
# 3. Enable 2FA for all users
# 4. Backup /data volume regularly
