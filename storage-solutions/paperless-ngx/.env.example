# Paperless-ngx Docker Environment Variables

# Web UI Port
PAPERLESS_PORT=8000

# Secret Key
# CRITICAL: Generate with: openssl rand -base64 32
PAPERLESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# Admin Account (created on first run)
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# OCR Language
# Use ISO 639-2 codes: eng, deu, fra, spa, etc.
# Multiple languages: eng+deu+fra
OCR_LANGUAGE=eng

# Timezone
TZ=America/New_York

# Directory Structure
# ===================
# ./consume/  - Drop files here for automatic import
# ./media/    - Processed documents stored here
# ./data/     - Database and search index
# ./export/   - Manual exports

# Consumption Workflow
# ====================
# 1. Drop PDF/image into ./consume/
# 2. Paperless OCRs and extracts text
# 3. Tika handles Word/Excel/etc.
# 4. Gotenberg converts to PDF/A
# 5. Document appears in web UI
