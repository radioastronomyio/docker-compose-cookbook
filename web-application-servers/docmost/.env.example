# Docmost Docker Environment Variables

# Web UI Port
DOCMOST_PORT=3000

# Application URL
APP_URL=http://localhost:3000

# Secret Key
# CRITICAL: Must be at least 32 characters
# Generate with: openssl rand -base64 32
APP_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG

# PostgreSQL Password
# CRITICAL: Change this password immediately
PG_PASSWORD=StrongDocmostPass2025!

# First Run
# =========
# 1. Access http://localhost:3000
# 2. Create your workspace and admin account
# 3. Invite team members

# WebSocket Note
# ==============
# Docmost uses WebSockets for real-time collaboration.
# When using a reverse proxy, ensure WebSocket support is enabled.
