# Penpot Docker Environment Variables

# Web UI Port
PENPOT_PORT=9001

# Public URL
PUBLIC_URI=http://localhost:9001

# Secret Key
# CRITICAL: Generate with: openssl rand -base64 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# PostgreSQL Password
# CRITICAL: Change this password immediately
PG_PASSWORD=StrongPenpotPass2025!

# Feature Flags
# disable-registration: Prevent public signups (enable after creating accounts)
# enable-login-with-password: Allow password-based login
# enable-smtp: Enable email notifications
# disable-email-verification: Skip email verification
PENPOT_FLAGS=disable-registration enable-login-with-password

# First Run (when registration is disabled)
# =========================================
# Temporarily enable registration:
# PENPOT_FLAGS=enable-registration enable-login-with-password
# Create your accounts, then restore the disabled flag.

# SMTP Configuration (optional)
# PENPOT_SMTP_DEFAULT_FROM=no-reply@example.com
# PENPOT_SMTP_DEFAULT_REPLY_TO=no-reply@example.com
# PENPOT_SMTP_HOST=smtp.example.com
# PENPOT_SMTP_PORT=587
# PENPOT_SMTP_USERNAME=user
# PENPOT_SMTP_PASSWORD=password
# PENPOT_SMTP_TLS=true
