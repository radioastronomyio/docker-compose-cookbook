# Twenty CRM Docker Environment Variables

# Web UI Port
TWENTY_PORT=3000

# Server URL
# CRITICAL: Set to your accessible URL for authentication callbacks
SERVER_URL=http://localhost:3000

# Secret Key
# CRITICAL: Generate with: openssl rand -base64 32
APP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# PostgreSQL Password
# CRITICAL: Change this password immediately
PG_PASSWORD=StrongTwentyPass2025!

# First Run
# =========
# 1. Access http://localhost:3000
# 2. Create your workspace
# 3. Sign up for admin account
# 4. Start importing contacts/companies

# Email Configuration (optional)
# EMAIL_FROM_ADDRESS=crm@example.com
# EMAIL_FROM_NAME=Twenty CRM
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=user
# EMAIL_SMTP_PASSWORD=password
